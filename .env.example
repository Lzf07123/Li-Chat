# Li&Chat 配置（复制为 .env 后修改；应用与 docker compose 共用本文件）
# 应用读取 LICHAT_* 前缀；compose 用其余变量做插值。

# ── 运行环境 ────────────────────────────────────────────────
# dev：本地开发；prod：启用 Secure Cookie，要求 ≥32 字符会话密钥
LICHAT_ENV=dev
# SQLite 本地开发；生产建议 PostgreSQL（如 postgresql+psycopg://user:pass@host:5432/lichat）
LICHAT_DATABASE_URL=sqlite+aiosqlite:///./data/lichat.db
# 留空 = 进程内实现（单副本）；配置后 jti 防重放与跨副本登出广播走 Redis
LICHAT_REDIS_URL=

# ── OIDC（Li&Pass 门户注册信息）─────────────────────────────
LICHAT_OIDC_ISSUER=https://account.lizf.cn
# 可选：显式指定发现文档地址，默认由 ISSUER 推导为 /.well-known/openid-configuration
# LICHAT_OIDC_DISCOVERY_URL=
LICHAT_OIDC_CLIENT_ID=li-chat-local
# LICHAT_OIDC_CLIENT_SECRET=
LICHAT_OIDC_REDIRECT_URI=http://localhost:8000/oidc/callback
LICHAT_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:8000/
LICHAT_OIDC_SCOPE=openid profile email

# ── 本地会话 ────────────────────────────────────────────────
# 生产必须 ≥32 字符；用于登出 state 签名与会话安全
LICHAT_SESSION_SECRET=please-change-me-in-production
# 滑动 2 小时 / 绝对 7 天
LICHAT_SESSION_SLIDING_TTL=7200
LICHAT_SESSION_ABSOLUTE_TTL=604800
LICHAT_SESSION_COOKIE_NAME=lichat_session

# ── OIDC 行为参数（一般无需修改）─────────────────────────────
# 回程登出令牌允许的最大时钟偏差（秒）；jti 防重放缓存保留 = 该值 + 60
LICHAT_LOGOUT_TOKEN_MAX_SKEW=120
# 发现文档缓存时长（秒）
LICHAT_DISCOVERY_CACHE_TTL=300

# ── 附件上传 ────────────────────────────────────────────────
# 单文件大小上限（MB，1–20）
LICHAT_UPLOAD_MAX_MB=10
# 附件存储目录（相对运行目录或绝对路径；生产建议挂卷持久化）
LICHAT_UPLOAD_DIR=./data/uploads
# 登录限流（/oidc/login 与 /oidc/callback，IP 粒度滑动窗口）
LICHAT_LOGIN_RATE_LIMIT=10
LICHAT_LOGIN_RATE_WINDOW=60

# ── 镜像加速与镜像源 ─────────────────────────────────────────
# 基础镜像加速（只影响 python/redis 拉取；已实测可用，可按网络情况切换）：
# BASE_IMAGE_REGISTRY=docker.m.daocloud.io/library/
# 应用镜像前缀：推送到私有仓库时设置（如 registry.example.com/li/），本地构建留空
# IMAGE_REGISTRY=
# pip/uv 索引镜像；备选：aliyun mirrors.aliyun.com/pypi/simple/ ｜ tuna pypi.tuna.tsinghua.edu.cn/simple
PYPI_INDEX_URL=https://mirrors.ustc.edu.cn/pypi/simple
# Debian 软件源镜像；备选：aliyun mirrors.aliyun.com/debian ｜ tuna mirrors.tuna.tsinghua.edu.cn/debian
APT_MIRROR=http://mirrors.ustc.edu.cn/debian

# ── docker compose 专属（应用忽略这些键）─────────────────────
# 宿主机暴露端口
LICHAT_PORT=8000
# 编排内 redis：口令（生产务必改强口令）、AOF、内存上限
REDIS_PASSWORD=lichat-dev-redis
REDIS_APPENDONLY=yes
REDIS_MAXMEMORY=192mb
# 容器时区
TZ=Asia/Shanghai
