{
  "issuer": "https://account.lizf.cn",
  "authorization_endpoint": "https://account.lizf.cn/oauth2/authorize",
  "token_endpoint": "https://account.lizf.cn/oauth2/token",
  "userinfo_endpoint": "https://account.lizf.cn/oauth2/userinfo",
  "jwks_uri": "https://account.lizf.cn/oauth2/jwks",
  "response_types_supported": ["code"],
  "grant_types_supported": ["authorization_code"],
  "subject_types_supported": ["public"],
  "id_token_signing_alg_values_supported": ["RS256"],
  "scopes_supported": ["openid", "profile", "email"],
  "code_challenge_methods_supported": ["S256"],
  "token_endpoint_auth_methods_supported": ["none", "client_secret_post"],
  "claims_supported": [
    "sub",
    "email",
    "email_verified",
    "nickname",
    "name",
    "picture",
    "acr",
    "sid"
  ],
  "end_session_endpoint": "https://account.lizf.cn/oauth2/end-session",
  "backchannel_logout_supported": true,
  "frontchannel_logout_supported": false
}
